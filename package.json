{
  "name": "arkify",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "gen-wallets": "tsx scripts/gen-wallets.ts",
    "fund": "tsx scripts/fund.ts",
    "spike": "tsx scripts/spike.ts",
    "smoke": "tsx scripts/smoke-core.ts",
    "verify": "tsx scripts/verify.ts",
    "measure-sources": "tsx scripts/measure-sources.ts",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p apps/web",
    "test": "vitest run --exclude '**/*.network.test.ts'",
    "test:network": "vitest run network.test",
    "verifier": "tsx packages/verifier/src/main.ts",
    "e2e": "tsx scripts/e2e.ts",
    "web": "pnpm --filter @arkify/web dev",
    "web:build": "pnpm --filter @arkify/web build",
    "purge-demo": "tsx scripts/purge.ts",
    "arkify": "tsx packages/cli/src/main.ts"
  },
  "dependencies": {
    "@arkiv-network/sdk": "0.8.1",
    "dotenv": "^18.0.6",
    "viem": "^2.57.4"
  },
  "devDependencies": {
    "@arkify/cli": "workspace:*",
    "@arkify/core": "workspace:*",
    "@arkify/engine": "workspace:*",
    "@arkify/verifier": "workspace:*",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
