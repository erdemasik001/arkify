# Never commit real keys. Copy to .env and run `pnpm gen-wallets`.
# The public endpoints work without a key, at about 100 queries an hour per address. Verifiers that
# run all day should use an access key from https://hub.arkiv.network/access-keys: append it to
# both URLs as a path, e.g. https://rpc.tiramisu.db-chain.testnet.arkiv.network/<key>. The key is a
# secret; it belongs here and never in the web app.
ARKIV_RPC_URL=https://rpc.tiramisu.db-chain.testnet.arkiv.network
ARKIV_WS_URL=wss://rpc.tiramisu.db-chain.testnet.arkiv.network
REQUESTER_PRIVATE_KEY=
VERIFIER_A_PRIVATE_KEY=
VERIFIER_B_PRIVATE_KEY=
VERIFIER_C_PRIVATE_KEY=
EVIL_PRIVATE_KEY=
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
MAINNET_RPC_URL=https://ethereum-rpc.publicnode.com

# A deployed verifier reads these two instead of the per-role keys above (see packages/verifier).
VERIFIER_NAME=
VERIFIER_PRIVATE_KEY=
# Optional. Where solc builds are cached, and how long one verification may run.
ARKIFY_SOLC_CACHE=.solc-cache
ARKIFY_VERIFY_TIMEOUT_SECONDS=180
